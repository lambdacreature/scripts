#!/usr/bin/env bash 

display_date_motd() {
    # to account for leap years
    year=$(date +"%Y")
    total_days=$(date -d "$year-12-31" +"%j")

    # date indexes days from 1 so this is a correct
    # way to count and above's too
    days_passed=$(( $(date +"%j") - 1))

    # bash does not handle floats
    # (( days_passed * 100 / total_days )) would truncate
    # and I need the result rounded to two decimal places
    percent=$(awk "BEGIN {printf \"%.2f\", $(( days_passed * 100 )) / $total_days}")

    date +"%A, %B %d, the $percent%% of %Y is gone"
}

display_date_motd
